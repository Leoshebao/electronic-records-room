# ===== 电子资料室系统 环境配置示例 =====
# 复制本文件为 .env 后按实际情况修改；.env 已被 .gitignore 忽略，不会入库

# ---- 应用 ----
APP_NAME=电子资料室系统
APP_ENV=production
DEBUG=false
# 生产环境务必替换为随机 64 位字符串，示例：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- 数据库 ----
POSTGRES_HOST=127.0.0.1
# Docker / 常规部署用 5432；Windows 便携版默认 4854
POSTGRES_PORT=5432
POSTGRES_DB=erecords
POSTGRES_USER=erecords
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- 文件存储 ----
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=500
BATCH_UPLOAD_LIMIT=50

# ---- 服务端 ----
# API 仅监听本机，由 Nginx / 预览服务对外
API_HOST=127.0.0.1
API_PORT=8000
# 对外访问地址（下载链接、水印等使用）
PUBLIC_BASE_URL=https://192.168.1.100:8443

# ---- 管理员初始账号（仅 seed_admin.py 使用）----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---- 文本解析 / OCR ----
OCR_ENGINE=paddleocr
OCR_LANG=ch
OCR_ENABLED=true
OCR_WORKER_ENABLED=true
OCR_WORKER_INTERVAL_SECONDS=5
OCR_MAX_RETRY=3
OCR_TASK_TIMEOUT_MINUTES=30
OCR_MAX_PAGES=50
OCR_MAX_CHARS=200000
OCR_IMAGE_DPI=200
# 文本层字符数达到该值则不再走 OCR，调大可强制 OCR
OCR_TEXT_LAYER_MIN_CHARS=20

# ---- 备份与回收站 ----
BACKUP_ROOT=./backups
BACKUP_KEEP_DAYS=30
RECYCLE_RETENTION_DAYS=30

# ---- 便携版 ----
PORTABLE_WEB_PORT=8080
