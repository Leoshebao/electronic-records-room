{
  "meta": {
    "name": "电子资料室系统 / Electronic Records Room",
    "version": "1.0.0",
    "type": "portable-offline",
    "root": ".（仓库根目录）",
    "entry": "http://127.0.0.1:8080",
    "os": "Windows 10/11 x64",
    "scale": "LAN 10-30 users, air-gapped",
    "archive_doc": "docs/architecture.md"
  },
  "stack": {
    "backend": "Python 3.11 + FastAPI 0.115.6 + SQLAlchemy 2.0.36 + Alembic 1.20.1",
    "db": "PostgreSQL 16.2 (port 4854, 127.0.0.1 only)",
    "frontend": "React 18.3.1 + TS 5.7.2 + Vite 6.0.7 + AntD 5.22.5",
    "auth": "JWT (PyJWT 2.9.0) + bcrypt",
    "ocr": "PaddleOCR design / NOT installed in runtime",
    "web": "Nginx+self-signed TLS (prod) / preview_server.py (portable)"
  },
  "ports": {
    "postgres": 4854,
    "api": 8000,
    "web": 8080
  },
  "roles": [
    "sysadmin",
    "records_manager",
    "viewer"
  ],
  "secrecy_levels": [
    "public",
    "internal",
    "secret",
    "confidential"
  ],
  "role_max_level": {
    "sysadmin": "confidential",
    "records_manager": "secret",
    "viewer": "internal"
  },
  "role_permissions": {
    "sysadmin": "all 14",
    "records_manager": "13 (no user:manage, no system:config, no backup:manage)",
    "viewer": [
      "doc:view",
      "borrow:apply"
    ]
  },
