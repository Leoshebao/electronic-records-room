  "known_limitations": [
    "OCR engine (paddleocr) not installed -> scanned files skipped",
    "portable edition serves plain HTTP on 127.0.0.1 (no TLS)",
    "requirements.txt versions differ from runtime actual versions",
    "category tree API has dual response shape (array vs grouped object)",
    "no React ErrorBoundary; component crash = blank page",
    "demo SECRET_KEY and default admin password must be changed before production"
  ],
  "verify": [
    "backend/scripts/run_all_verify.py",
    "backend/scripts/verify_api_contract.py",
    "backend/scripts/verify_frontend_api.py",
    "frontend npm run build (tsc --noEmit must pass)"
  ]
}